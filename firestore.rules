rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzioni di utilità per semplificare le regole
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Regole per la collezione Matches (Partite)
    // - Tutti gli utenti loggati possono leggere le partite.
    // - Solo l'admin può creare, modificare o eliminare partite.
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Regole per la collezione Matchdays (Configurazione Giornate)
    // - Tutti gli utenti loggati possono leggere la configurazione (lock, status, etc.).
    // - Solo l'admin può modificare le scadenze o lo stato della giornata.
    match /matchdays/{giornata} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Regole per la collezione Users (Profili e Statistiche)
    // - Tutti gli utenti loggati possono leggere i profili (necessario per la classifica).
    // - Un utente può creare il proprio profilo durante la registrazione.
    // - Un utente può aggiornare i propri dati (SOLO displayName e photoURL).
    // - L'admin può modificare tutto (inclusi i punti).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Regole per la collezione Predictions (Pronostici)
    // - Tutti gli utenti loggati possono leggere i pronostici (per trasparenza tra amici).
    // - Un utente può creare/modificare solo i propri pronostici PRIMA del blocco.
    // - L'admin può gestire tutto per correzioni manuali.
    match /predictions/{predictionId} {
      allow read: if isSignedIn();
      
      // Funzione per verificare se la giornata è ancora aperta
      function isGiornataOpen(matchId) {
        let match = get(/databases/$(database)/documents/matches/$(matchId)).data;
        let matchday = get(/databases/$(database)/documents/matchdays/$(string(match.giornata))).data;
        // Se non c'è lockDateTime, la giornata è aperta. 
        // Se c'è, confrontiamo con request.time (timestamp di Firestore)
        // Nota: matchday.lockDateTime deve essere un Timestamp per il confronto diretto, 
        // ma se è una stringa ISO, il confronto è più complesso in Rules.
        // Assumiamo che l'admin imposti lockDateTime correttamente.
        return matchday.lockDateTime == null || request.time < timestamp(matchday.lockDateTime);
      }

      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      isGiornataOpen(request.resource.data.matchId);
      
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        isGiornataOpen(resource.data.matchId)
      );

      allow delete: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        isGiornataOpen(resource.data.matchId)
      );
    }
  }
}
