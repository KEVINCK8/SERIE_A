rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Funzioni di utilità per semplificare le regole
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Regole per la collezione Matches (Partite)
    // - Tutti gli utenti loggati possono leggere le partite.
    // - Solo l'admin può creare, modificare o eliminare partite.
    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Regole per la collezione Matchdays (Configurazione Giornate)
    // - Tutti gli utenti loggati possono leggere la configurazione (lock, status, etc.).
    // - Solo l'admin può modificare le scadenze o lo stato della giornata.
    match /matchdays/{giornata} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Regole per la collezione Users (Profili e Statistiche)
    // - Tutti gli utenti loggati possono leggere i profili (necessario per la classifica).
    // - Un utente può creare il proprio profilo durante la registrazione.
    // - Un utente può aggiornare i propri dati (SOLO displayName e photoURL).
    // - L'admin può modificare tutto (inclusi i punti).
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isOwner(userId) && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // Regole per la collezione Predictions (Pronostici)
    // - Ogni utente può leggere i propri pronostici.
    // - L'admin può leggere e gestire tutto.
    // - I pronostici degli altri utenti diventano leggibili solo dopo il blocco della giornata.
    // - Un utente può creare/modificare solo i propri pronostici PRIMA del blocco.
    match /predictions/{predictionId} {
      function matchdayData(matchId) {
        let match = get(/databases/$(database)/documents/matches/$(matchId)).data;
        return get(/databases/$(database)/documents/matchdays/$(string(match.giornata))).data;
      }

      // Funzione per verificare se la giornata è ancora aperta
      function isGiornataOpen(matchId) {
        let matchday = matchdayData(matchId);
        // lockAtMillis viene salvato dal client insieme a lockDateTime.
        return matchday.lockAtMillis == null || request.time.toMillis() < matchday.lockAtMillis;
      }

      function isGiornataClosed(matchId) {
        return !isGiornataOpen(matchId);
      }

      allow read: if isAdmin() ||
                    (isSignedIn() && resource.data.userId == request.auth.uid) ||
                    (isSignedIn() && isGiornataClosed(resource.data.matchId));

      allow create: if isSignedIn() && 
                      request.resource.data.userId == request.auth.uid &&
                      isGiornataOpen(request.resource.data.matchId);
      
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        isGiornataOpen(resource.data.matchId)
      );

      allow delete: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        isGiornataOpen(resource.data.matchId)
      );
    }
  }
}
